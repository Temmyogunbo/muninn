# Your OpenAI API key (get from https://platform.openai.com/api-keys)
openai_api_key = ""

#  Reporter Configuration
# Copy this file to terraform.tfvars and update with your values

# Your AWS region for Lambda functions
# Should match your database region from Database
aws_region = "us-east-2"

# Aurora cluster ARN from Database (get from Terraform output)
aurora_cluster_arn = ""

# Aurora secret ARN from Database (get from Terraform output)
aurora_secret_arn = ""


# Bedrock model configuration
# Using Amazon Nova Pro model for better reliability
bedrock_model_id = "us.amazon.nova-pro-v1:0"

# Bedrock region (us-east-2 has the most models available)
# Note: This can be different from your Lambda region - cross-region calls work fine
bedrock_region = "us-east-2"

# LangFuse observability configuration (optional)
# Leave commented out until we use LangFuse - we start LangFuse in Part 8 / Day 4

# langfuse_public_key = "pk-lf-..." # Add your pk-lf-xxx key here - be sure this is the one that starts pk
# langfuse_secret_key = "sk-lf-..." # Add your sk-lf-xxx key here - be sure this is the one that starts sk
# langfuse_host       = "https://us.cloud.langfuse.com"
